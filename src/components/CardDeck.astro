    <!-- CARD 7: LINKEDIN (Electric Blue Workspace Illustration) -->
    <a 
      href="https://www.linkedin.com/in/vishandey" 
      target="_blank" 
      rel="noopener noreferrer" 
      data-card-index="6"
      class="deck-card shrink-0 group relative w-[180px] sm:w-[210px] md:w-[230px] h-[300px] sm:h-[350px] md:h-[380px] rounded-2xl bg-gradient-to-b from-[#1C4DB5] via-[#2167DC] to-[#123E98] border border-white/20 p-5 flex flex-col justify-between overflow-hidden shadow-[0_25px_60px_rgba(0,0,0,0.7)] -ml-14 sm:-ml-18 md:-ml-22 cursor-pointer transition-all duration-300 ease-out text-white z-16"
      style="--hover-rot: -1deg;"
    >
      <div class="font-dmsans font-black text-xs tracking-wider uppercase text-white/90">

---
// Experience.astro: Career experience section with bespoke horizontal banners
import { VISHAN_DATA } from '../data/portfolioData';

const experiences = VISHAN_DATA.experience;
---

<section id="career" class="w-full pt-20 sm:pt-40 pb-20 sm:pb-36 px-4 sm:px-6">
  <span id="experience" class="sr-only"></span>
  <div class="max-w-4xl mx-auto">
    
    <!-- Section Heading -->
    <div class="mb-10 sm:mb-12">
      <h2 class="font-ptserif text-3xl sm:text-4xl text-white font-normal tracking-tight mb-2">
        career
      </h2>
      <p class="font-dmsans text-sm sm:text-base text-white/50">
        roles I've held and what I worked on:
      </p>
    </div>

    <!-- Experience List -->
    <div class="space-y-12 sm:space-y-20">
      {experiences.map((exp) => (
        <article class="flex flex-col gap-5 group">
          
          <!-- Bespoke Rectangular-Shaped Horizontal Banner -->
          {exp.id === 'bhaicode-exp' && (
            <div class="w-full h-20 sm:h-24 rounded-2xl overflow-hidden relative bg-gradient-to-r from-[#18122c] via-[#100d1e] to-[#0a0712] border border-purple-500/25 px-5 sm:px-6 flex items-center justify-between transition-all duration-300 shadow-xl group-hover:border-purple-500/40 group-hover:shadow-[0_20px_40px_rgba(124,58,237,0.15)]">
              <!-- Right background artwork faded -->
              <div class="absolute right-0 top-0 bottom-0 w-1/2 opacity-20 pointer-events-none overflow-hidden">
                <img src="/images/bhaicode-art-indic.jpg" alt="BhaiCode preview" class="w-full h-full object-cover object-left" />
                <div class="absolute inset-0 bg-gradient-to-r from-[#100d1e] via-transparent to-transparent"></div>
              </div>
              <div class="flex items-center gap-3.5 sm:gap-4 relative z-10">
                <img src="/images/bhaicode-icon.svg" alt="BhaiCode Logo" class="w-8 h-8 sm:w-10 sm:h-10 object-contain shrink-0" />
                <span class="font-dmsans font-extrabold text-base sm:text-xl tracking-tight text-white uppercase">
                  BhaiCode Project
                </span>
              </div>
              <div class="relative z-10 hidden sm:flex items-center">
                <span class="font-mono text-xs font-semibold text-white/90">2025 – Present</span>
              </div>
            </div>
          )}

          {exp.id === 'wyve' && (
            <div class="w-full h-20 sm:h-24 rounded-2xl overflow-hidden relative bg-gradient-to-r from-[#221a0e] via-[#141009] to-[#090704] border border-amber-400/25 px-5 sm:px-6 flex items-center justify-between transition-all duration-300 shadow-xl group-hover:border-amber-400/40 group-hover:shadow-[0_20px_40px_rgba(245,158,11,0.15)]">
              <!-- Right background studio art faded -->
              <div class="absolute right-0 top-0 bottom-0 w-1/2 opacity-20 pointer-events-none overflow-hidden">
                <img src="/images/wyve-art.jpg" alt="Wyve art" class="w-full h-full object-cover object-center" />
                <div class="absolute inset-0 bg-gradient-to-r from-[#141009] via-transparent to-transparent"></div>
              </div>
              <div class="flex items-center gap-3.5 sm:gap-4 relative z-10">
                <img src="/images/wyve-favicon.webp" alt="WyVE Logo" class="w-8 h-8 sm:w-10 sm:h-10 object-contain shrink-0" />
                <span class="font-dmsans font-extrabold text-base sm:text-xl tracking-tight text-white uppercase">
                  WyVE MEDIA
                </span>
              </div>
              <div class="relative z-10 hidden sm:flex items-center">
                <span class="font-mono text-xs font-semibold text-white/90">2025 – Present</span>
              </div>
            </div>
          )}

          {exp.id === 'drmeets-exp' && (
            <div class="w-full h-20 sm:h-24 rounded-2xl overflow-hidden relative bg-gradient-to-r from-[#0c2024] via-[#081518] to-[#040b0d] border border-teal-500/25 px-5 sm:px-6 flex items-center justify-between transition-all duration-300 shadow-xl group-hover:border-teal-500/40 group-hover:shadow-[0_20px_40px_rgba(20,184,166,0.15)]">
              <div class="flex items-center gap-3.5 sm:gap-4 relative z-10">
                <img src="/images/drmeets-logo.png" alt="DrMeets Logo" class="w-8 h-8 sm:w-10 sm:h-10 object-contain shrink-0" />
                <span class="font-dmsans font-extrabold text-base sm:text-xl tracking-tight text-white uppercase">
                  DrMeets Health
                </span>
              </div>
              <div class="relative z-10 hidden sm:flex items-center">
                <span class="font-mono text-xs font-semibold text-white/90">2025 – 2026</span>
              </div>
            </div>
          )}

          {exp.id === 'skillo-exp' && (
            <div class="w-full h-20 sm:h-24 rounded-2xl overflow-hidden relative bg-gradient-to-r from-[#0f172a] via-[#0c1222] to-[#060913] border border-blue-500/25 px-5 sm:px-6 flex items-center justify-between transition-all duration-300 shadow-xl group-hover:border-blue-500/40 group-hover:shadow-[0_20px_40px_rgba(59,130,246,0.15)]">
              <div class="flex items-center gap-3.5 sm:gap-4 relative z-10">
                <img src="/images/skillo-logo.webp" alt="Skillo Logo" class="w-8 h-8 sm:w-10 sm:h-10 object-contain shrink-0" />
                <span class="font-dmsans font-extrabold text-base sm:text-xl tracking-tight text-white uppercase">
                  Skillo Learning
                </span>
              </div>
              <div class="relative z-10 hidden sm:flex items-center">
                <span class="font-mono text-xs font-semibold text-white/90">2025</span>
              </div>
            </div>
          )}

          <!-- Fallback if any other experience item is added -->
          {!['bhaicode-exp', 'wyve', 'drmeets-exp', 'skillo-exp'].includes(exp.id) && (
            <div class="w-full h-20 sm:h-24 rounded-2xl overflow-hidden ios-glass-card flex items-center justify-between px-5 sm:px-6 transition-all duration-300">
              <span class="font-dmsans font-extrabold text-base sm:text-xl tracking-tight uppercase text-white">
                {exp.company}
              </span>
              <span class="font-mono text-xs text-white/50">{exp.period}</span>
            </div>
          )}

          <!-- Role & Company Details Row -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1">
            <div>
              <h3 class="font-dmsans text-lg sm:text-xl font-medium text-white tracking-tight">
                {exp.role} <span class="text-white/40 font-normal">&bull; {exp.company}</span>
              </h3>
              <p class="font-dmsans text-xs sm:text-sm text-white/50 pt-0.5">
                {exp.period} &bull; {exp.location}
              </p>
            </div>

            {exp.url && (
              <a 
                href={exp.url} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="self-start sm:self-auto inline-flex items-center justify-center gap-1.5 px-4 py-1.5 rounded-xl ios-glass-pill hover:brightness-125 text-white text-xs sm:text-sm font-dmsans font-medium transition-all shrink-0"
              >
                <span>view details</span>
                <span class="text-xs">↗</span>
              </a>
            )}
          </div>

          <!-- Bullet Points -->
          <ul class="space-y-2 pt-1 font-dmsans text-sm text-white/60 leading-relaxed list-none">
            {exp.points.map((point) => (
              <li class="flex items-start gap-2.5">
                <span class="text-white/40 mt-1 select-none">&bull;</span>
                <span>{point}</span>
              </li>
            ))}
          </ul>

          <!-- Skills Badges -->
          <div class="flex flex-wrap gap-2 pt-1">
            {exp.skills.map((skill) => (
              <span class="px-2.5 py-1 rounded-md bg-white/[0.03] border border-white/5 text-[11px] font-mono text-white/40">
                {skill}
              </span>
            ))}
          </div>

        </article>
      ))}
    </div>

  </div>
</section>

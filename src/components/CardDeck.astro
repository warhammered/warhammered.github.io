  </div>
</div>

<style>
  /* Authentic Apple iOS Glass Card Foundation */
  .deck-card {
    backdrop-filter: blur(24px) saturate(190%) contrast(105%) !important;
    -webkit-backdrop-filter: blur(24px) saturate(190%) contrast(105%) !important;
    border: 1px solid rgba(255, 255, 255, 0.16) !important;
    box-shadow: 
      inset 0 1px 1.5px 0 rgba(255, 255, 255, 0.35),
      inset 0 0 0 1px rgba(255, 255, 255, 0.05),
      0 25px 60px rgba(0, 0, 0, 0.75) !important;
    transition: transform 450ms cubic-bezier(0.16, 1, 0.3, 1), 
                filter 450ms cubic-bezier(0.16, 1, 0.3, 1), 
                box-shadow 450ms cubic-bezier(0.16, 1, 0.3, 1), 
                opacity 450ms cubic-bezier(0.16, 1, 0.3, 1) !important;
    transform-style: preserve-3d;
    will-change: transform, filter, box-shadow;
  }

  /* Specular Apple Glass Sheen across the top edge */
  .deck-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: linear-gradient(135deg, rgba(255, 255, 255, 0.14) 0%, rgba(255, 255, 255, 0.02) 45%, transparent 80%);
    pointer-events: none;
    z-index: 2;
  }

  /* Mobile-first base: full swipeable pointer events and smooth momentum touch scrolling */
  .card-deck-container {
    pointer-events: auto;
    -webkit-overflow-scrolling: touch;
    overscroll-behavior-x: contain;
    touch-action: pan-x pan-y;
  }

  #interactive-card-deck {
    pointer-events: auto;
    touch-action: pan-x pan-y;
  }

  .deck-card {
    pointer-events: auto;
    touch-action: pan-x pan-y;
  }

  /* Desktop hover and sibling depression: ONLY when mouse/trackpad is present */
  @media (hover: hover) and (pointer: fine) {
    .card-deck-container,
    #interactive-card-deck {
      pointer-events: none;
    }

    .deck-card {
      pointer-events: auto;
    }

    /* Sibling Depression: Non-hovered cards sink down and blur */
    .card-deck-container.has-active-card .deck-card {
      filter: blur(6px) opacity(0.35);
      transform: translateY(14px) scale(0.93);
    }

    /* Active Lift with Multi-Stage iOS Glass Shadows */
    .card-deck-container.has-active-card .deck-card.is-active-hover {
      filter: blur(0px) opacity(1) !important;
      transform: translateY(-56px) scale(1.14) rotate(calc(var(--hover-rot, 0deg) * 1.5)) !important;
      z-index: 50 !important;
      border-color: rgba(255, 255, 255, 0.32) !important;
      box-shadow: 
        inset 0 1.5px 2px 0 rgba(255, 255, 255, 0.6),
        inset 0 0 0 1px rgba(255, 255, 255, 0.12),
        0 50px 115px -15px rgba(0, 0, 0, 0.98),
        0 25px 55px -10px rgba(0, 0, 0, 0.85),
        0 0 40px -5px rgba(255, 255, 255, 0.16) !important;
    }

    .card-deck-container:has(.deck-card:hover) .deck-card {
      filter: blur(6px) opacity(0.35);
      transform: translateY(14px) scale(0.93);
    }

    .card-deck-container .deck-card:hover {
      filter: blur(0px) opacity(1) !important;
      transform: translateY(-56px) scale(1.14) rotate(calc(var(--hover-rot, 0deg) * 1.5)) !important;
      z-index: 50 !important;
      border-color: rgba(255, 255, 255, 0.32) !important;
      box-shadow: 
        inset 0 1.5px 2px 0 rgba(255, 255, 255, 0.6),
        inset 0 0 0 1px rgba(255, 255, 255, 0.12),
        0 50px 115px -15px rgba(0, 0, 0, 0.98),
        0 25px 55px -10px rgba(0, 0, 0, 0.85),
        0 0 40px -5px rgba(255, 255, 255, 0.16) !important;
    }
  }

  /* Tactile feedback on touch tap */
  @media (pointer: coarse) {
    .deck-card:active {
      transform: scale(0.97) !important;
      transition: transform 100ms ease-out !important;
    }
  }

  /* Hide scrollbar on horizontal swipe */
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  .no-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
</style>

<script>
  function initCardDeckInteractions() {
    const container = document.querySelector('.card-deck-container');
    const cards = document.querySelectorAll('.deck-card') as NodeListOf<HTMLElement>;

    if (!container || !cards.length) return;

    // Strictly isolate 3D mouse hover & tilt effects to fine desktop pointers
    // On touch/mobile devices, prevent cards from getting stuck in blurred state
    if (!window.matchMedia('(hover: hover) and (pointer: fine)').matches) {
      return;
    }

    cards.forEach((card) => {
      card.addEventListener('mouseenter', () => {
        container.classList.add('has-active-card');
        card.classList.add('is-active-hover');
      });

      card.addEventListener('mousemove', (e: MouseEvent) => {
        if (!card.classList.contains('is-active-hover')) return;
        const rect = card.getBoundingClientRect();

        // Strict boundary containment: no hover outside of card bounds even slightly
        if (
          e.clientX < rect.left || 
          e.clientX > rect.right || 
          e.clientY < rect.top || 
          e.clientY > rect.bottom
        ) {
          card.classList.remove('is-active-hover');
          card.style.transform = '';
          const anyActive = document.querySelector('.deck-card.is-active-hover');
          if (!anyActive) {
            container.classList.remove('has-active-card');
          }
          return;
        }

        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;
        // Subtle tactile 3D tilt (-6deg to +6deg)
        const rotX = ((y - centerY) / centerY) * -6;
        const rotY = ((x - centerX) / centerX) * 6;
        const baseRotStr = card.style.getPropertyValue('--hover-rot') || '0deg';
        const baseRot = parseFloat(baseRotStr) || 0;

        card.style.transform = `translateY(-56px) scale(1.14) perspective(900px) rotateX(${rotX.toFixed(2)}deg) rotateY(${rotY.toFixed(2)}deg) rotate(${(baseRot * 1.5).toFixed(2)}deg)`;
      });

      card.addEventListener('mouseleave', () => {
        card.classList.remove('is-active-hover');
        card.style.transform = '';
        const anyActive = document.querySelector('.deck-card.is-active-hover');
        if (!anyActive) {
          container.classList.remove('has-active-card');
        }
      });
    });

    container.addEventListener('mouseleave', () => {
      container.classList.remove('has-active-card');
      cards.forEach((c) => {
        c.classList.remove('is-active-hover');
        c.style.transform = '';
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCardDeckInteractions);
  } else {
    initCardDeckInteractions();
  }
</script>

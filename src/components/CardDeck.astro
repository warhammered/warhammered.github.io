      <!-- Isometric Workspace Illustration -->
      <div class="my-auto relative flex items-center justify-center">
        <div class="w-14 sm:w-16 h-14 sm:h-16 rounded-xl bg-white/10 border border-white/20 flex flex-col items-center justify-center gap-1 shadow-inner">
          <div class="w-7 sm:w-8 h-4 sm:h-5 rounded bg-blue-300/40 border border-white/30"></div>
          <div class="w-3 sm:w-4 h-1.5 rounded-full bg-white/40"></div>
          <div class="w-5 sm:w-6 h-1 bg-white/20"></div>
        </div>
      </div>

      <div class="font-mono text-[10px] text-blue-200/70 tracking-wider">
        CONNECT ON LINKEDIN ↗
      </div>

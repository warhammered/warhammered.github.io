    <!-- CARD 8: CONTACT (Warm Amber / Yellow Envelope Mail card) -->
    <a 
      href="#contact" 
      data-card-index="7"
      class="deck-card shrink-0 group relative w-[180px] sm:w-[210px] md:w-[230px] h-[300px] sm:h-[350px] md:h-[380px] rounded-2xl bg-gradient-to-b from-[#F2B93B] via-[#E2A627] to-[#C98F17] border border-white/30 p-5 flex flex-col justify-between overflow-hidden shadow-[0_25px_60px_rgba(0,0,0,0.7)] -ml-14 sm:-ml-18 md:-ml-22 cursor-pointer transition-all duration-300 ease-out text-stone-900 z-17"
      style="--hover-rot: 2deg;"
    >
      <div class="font-dmsans font-black text-xs tracking-wider uppercase text-stone-900/90">
        CONTACT
      </div>

      <!-- 3D Embossed Envelope Mail Symbol -->
      <div class="my-auto flex items-center justify-center">
        <svg class="w-16 sm:w-20 h-14 sm:h-16 text-stone-900/80 drop-shadow-md" viewBox="0 0 64 48" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
          <rect x="4" y="6" width="56" height="36" rx="4" fill="rgba(255,255,255,0.2)"/>
          <path d="M4 10L32 30L60 10"/>
        </svg>
      </div>

      <div class="font-mono text-[10px] text-stone-900/70 tracking-wider font-bold">
        SAY HELLO ↗
      </div>
    </a>

    <!-- CARD 9: RESUME (Dark Graphite with Giant Typography "Re / su / me") -->
    <a 
      href="/vishan-dey-resume.pdf" target="_blank" rel="noopener noreferrer"
      data-card-index="8"
      class="deck-card shrink-0 group relative w-[180px] sm:w-[210px] md:w-[230px] h-[300px] sm:h-[350px] md:h-[380px] rounded-2xl bg-[#1C1C1E] border border-white/10 p-5 flex flex-col justify-between overflow-hidden shadow-[0_25px_60px_rgba(0,0,0,0.7)] -ml-14 sm:-ml-18 md:-ml-22 cursor-pointer transition-all duration-300 ease-out z-18"
      style="--hover-rot: -2deg;"
    >
      <!-- Top Title -->
      <div class="font-dmsans font-black text-xs tracking-wider uppercase text-white/50">
        CV / DOSSIER
      </div>

      <!-- Giant Stacked Typography matching Kushagra's "Re su me" -->
      <div class="my-auto leading-[0.85] font-ptserif font-bold text-4xl sm:text-5xl md:text-6xl text-stone-600/60 select-none tracking-tight">
        <div>Re</div>
        <div>su</div>
        <div>me</div>
      </div>

      <div class="font-mono text-[10px] text-white/60 tracking-wider flex items-center justify-between">

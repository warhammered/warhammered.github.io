---
// ProjectsV2.astro: Projects showcase matching kushagrasingh.in 1-to-1
import { VISHAN_DATA } from '../data/portfolioData';

// Select standout projects for showcase
const featuredProjects = VISHAN_DATA.projects;
---

<section id="projects" class="w-full pt-20 sm:pt-40 pb-20 sm:pb-40 px-4 sm:px-6">
  <div class="max-w-4xl mx-auto">
    
    <!-- Section Heading with View All Button -->
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-12 sm:mb-16">
      <div>
        <h2 class="font-ptserif text-3xl sm:text-4xl text-white font-normal tracking-tight mb-2">
          projects
        </h2>
        <p class="font-dmsans text-sm sm:text-base text-white/50">
          some of my recent works:
        </p>
      </div>

      <!-- View All Button -->
      <a 
        href="https://github.com/warhammered?tab=repositories" 
        target="_blank" 
        rel="noopener noreferrer" 
        class="self-start sm:self-auto inline-flex items-center gap-1.5 px-4 py-2 rounded-full ios-glass-pill hover:brightness-125 text-xs sm:text-sm font-dmsans text-white/90 hover:text-white transition-all group"
      >
        <span>view all</span>
        <span class="text-xs transition-transform duration-200 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
      </a>
    </div>

    <!-- Project List -->
    <div class="space-y-16 sm:space-y-36">
      {featuredProjects.map((project, idx) => (
        <article class="flex flex-col gap-5">
          
          <!-- Mockup Frame with Authentic iOS Glass Card Architecture (Stable, zero heavy hover lift) -->
          <div class="w-full rounded-2xl overflow-hidden ios-glass-card shadow-2xl">
            <!-- Browser-like preview window with subtle glass top bar -->
            <div class="w-full px-4 py-2.5 bg-white/[0.04] border-b border-white/10 backdrop-blur-md flex items-center">
              <span class="text-[11px] font-mono text-white/40 truncate">
                {project.liveUrl ? project.liveUrl.replace(/^https?:\/\//, '').replace(/\/$/, '') : `${project.title.toLowerCase()}.dev`}
              </span>
            </div>
            
            <div class="w-full aspect-[16/10] sm:aspect-[16/10] overflow-hidden bg-black/40 relative group/preview">
              <img 
                src={project.image} 
                alt={`${project.title} — ${project.subtitle}`}
                class="w-full h-full object-cover object-top"
                loading={idx < 2 ? "eager" : "lazy"}
              />
              {project.image?.includes('placeholder') && (
                <div class="absolute bottom-3 right-3 sm:bottom-4 sm:right-4 px-2.5 sm:px-3 py-1 sm:py-1.5 rounded-lg bg-black/60 border border-white/10 backdrop-blur-md flex items-center gap-2 pointer-events-none">
                  <span class="w-1.5 h-1.5 sm:w-2 sm:h-2 rounded-full bg-amber-400 animate-pulse"></span>
                  <span class="font-mono text-[9px] sm:text-[10px] text-white/60 uppercase tracking-wider">{project.title.toLowerCase()} // capture pending</span>
                </div>
              )}
            </div>
          </div>

          <!-- Project Title & Link Button Row -->
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-1">
            <h3 class="font-dmsans text-lg sm:text-xl font-medium text-white tracking-tight">
              <span class="text-white capitalize">{project.title.toLowerCase()}</span>
              <span class="text-white/50 font-normal"> – {project.subtitle}</span>
            </h3>

            {project.liveUrl && (
              <a 
                href={project.liveUrl} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="self-start sm:self-auto inline-flex items-center justify-center gap-1.5 px-4 py-1.5 rounded-xl ios-glass-pill hover:brightness-125 text-white text-xs sm:text-sm font-dmsans font-medium transition-all shrink-0"
              >
                <span>view project</span>
                <span class="text-xs">↗</span>
              </a>
            )}
          </div>

          <!-- Description Paragraph -->
          <p class="font-dmsans text-sm sm:text-base text-white/60 leading-relaxed max-w-3xl">
            {project.summary}
          </p>

          <!-- Deliverables & Tech Stack Tags -->
          <div class="flex flex-wrap gap-2 pt-1">
            {project.techStack.map((tech) => (
              <span class="px-2.5 py-1 rounded-md bg-white/[0.03] border border-white/5 text-[11px] font-mono text-white/50">
                {tech}
              </span>
            ))}
          </div>

        </article>
      ))}
    </div>

  </div>
</section>
